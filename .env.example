# Seed / universe
TV_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
UNIVERSE_SOURCE=binance
TV_EXCHANGE=BINANCE
TV_INTERVAL=1h

# Strategy
TREND_GATE_MODE=supertrend
BUY_THRESHOLD=0.55
SELL_THRESHOLD=-0.55
POSITION_SIZE_USDT=100
MIN_ORDER_USDT=10
MAX_OPEN_POSITIONS=8
MAX_OPEN_SHORTS=3
SHORT_ENABLED=true
SHORT_ML_PROB_MAX=0.40
STOP_LOSS_PCT=0.06
TAKE_PROFIT_PCT=0.05
TRAILING_TP_ENABLED=true
TRAILING_TP_CALLBACK_PCT=0.015
POSITION_MONITOR_INTERVAL_MS=1000
TRAILING_STATE_FILE=trailing_positions.json
MIN_PRICE=0.00000001
MAX_PRICE=10000000

# Trading mode: paper = virtual USDT balance on real Binance market data
TRADING_MODE=paper

# Paper trading portfolio (USDT)
PAPER_INITIAL_BALANCE_USDT=1000
PAPER_STATE_FILE=paper_state.json
PAPER_BALANCE_STATE_FILE=paper_balance_state.json
PAPER_COMMISSION_RATE=0.001
PAPER_COMMISSION_MIN_USDT=0
PAPER_INCLUDE_COMMISSION=true
PAPER_BUY_BAR_CONFIRMATION=true

# Binance public API (no keys needed for paper market data)
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_UNIVERSE_QUOTE=USDT
BINANCE_UNIVERSE_LIMIT=50
BINANCE_MIN_QUOTE_VOLUME=5000000
BINANCE_UNIVERSE_CACHE_FILE=binance_universe_cache.json
UNIVERSE_REFRESH_CYCLES=30
UNIVERSE_OVERRIDES_FILE=universe_overrides.json

# Optional live keys (not used while TRADING_MODE=paper)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# OpenAI (optional risk filter / adaptive proposals)
ENABLE_AI_RISK_FILTER=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REBALANCE_CYCLES=20
STRATEGY_STATE_FILE=strategy_state.json

# Telegram notifications — insert your bot token here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_HOLD=false

# Runtime
POLL_SECONDS=60
STRATEGY_MODE=supertrend_ml
ML_ENABLED=true
ML_PROB_THRESHOLD=0.10

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_DB_PATH=analytics.db
ANALYTICS_STRATEGY_VERSION=binance-paper
ANALYTICS_LOG_HOLDS=true
ANALYTICS_OUTCOME_EVAL_ENABLED=true
ANALYTICS_DB_MAX_MB=10240
ANALYTICS_DB_TARGET_MB=9216
ANALYTICS_DB_MAINTENANCE_CYCLES=5
ANALYTICS_DB_MIN_RETENTION_DAYS=90
POSITION_MGMT_MODE=off

# Adaptive self-analysis
ADAPTIVE_MODE=paper
ADAPTIVE_USE_DB_VOLUME_LOOP=true
ADAPTIVE_STATE_FILE=adaptive_state.json
ADAPTIVE_LOOKBACK_DAYS=14
ADAPTIVE_REFRESH_CYCLES=5
ADAPTIVE_MIN_OBSERVATIONS=5
ADAPTIVE_NEGATIVE_OUTCOME_PCT=-0.25
ADAPTIVE_POSITIVE_OUTCOME_PCT=0.05
ADAPTIVE_MAX_THRESHOLD_DELTA_FRAC=0.15

# Blacklist candidates — only after enough practice; no Telegram spam by default
BLACKLIST_PROPOSER_ENABLED=true
BLACKLIST_CANDIDATES_FILE=blacklist_candidates.json
BLACKLIST_LOOKBACK_DAYS=14
BLACKLIST_MIN_OBSERVATIONS=15
BLACKLIST_POOR_OUTCOME_PCT=-1.0
BLACKLIST_LOW_VOLUME_USDT=200000
BLACKLIST_REFRESH_CYCLES=30
BLACKLIST_MIN_CLOSED_TRADES_GLOBAL=40
BLACKLIST_MIN_ACTIVE_DAYS=3
BLACKLIST_NOTIFY_TELEGRAM=false
BLACKLIST_LIQUIDITY_FAIL_COUNT=3
